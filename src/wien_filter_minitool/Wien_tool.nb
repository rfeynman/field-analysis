                RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
              RowBox[{"(*", 
               RowBox[{"xFinal", "[", "m", "]"}], "*)"}], 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"f", "[", 
