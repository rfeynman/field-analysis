        "\[IndentingNewLine]", 
        RowBox[{"m", "=", 
         RowBox[{"9.1093837015", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "31"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"c", "=", "299792458."}], ";", "\[IndentingNewLine]", 
        RowBox[{"e", "=", 
         RowBox[{"1.602176634", "*", 
          RowBox[{"10", "^", 
           RowBox[{"-", "19"}]}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"momentum", ":", 
           RowBox[{"SI", " ", "kg", " ", 
            RowBox[{"m", "/", "s"}]}]}], "->", 
          RowBox[{"keV", "/", "c"}]}], "*)"}], 
        RowBox[{
         RowBox[{"pSIToKeVoverC", "[", "pSI_", "]"}], ":=", 
         RowBox[{"pSI", "*", 
          RowBox[{
           RowBox[{"c", "/", "e"}], "/", "1000."}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
