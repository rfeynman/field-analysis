           RowBox[{
           "Print", 
            "[", "\"\<Error: input must be an N x 6 particle array: \
{x,y,z,px,py,pz}.\>\"", "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "$Failed", "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pointSize", "=", 
         RowBox[{"OptionValue", "[", "\"\<PointSize\>\"", "]"}]}], ";", 
