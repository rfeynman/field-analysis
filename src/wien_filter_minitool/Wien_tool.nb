             RowBox[{"dist", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "i", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{"x", "[", "m", "]"}], "*)"}], 
             RowBox[{
              RowBox[{"dist", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "i", ",", "4"}], "]"}], "]"}], "/", 
              RowBox[{"dist", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "i", ",", "6"}], "]"}], "]"}]}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"x", "'"}], "=", 
               RowBox[{"px", "/", "pz"}]}], "*)"}], 
             RowBox[{"keV", "[", 
              RowBox[{"dist", "[", 
