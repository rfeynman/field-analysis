Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"mElectron", "=", 
     RowBox[{"9.1093837015", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "31"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cLight", "=", "299792458."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"eCharge", "=", 
     RowBox[{"1.602176634", "*", 
      RowBox[{"10", "^", 
       RowBox[{"-", "19"}]}]}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gamma0", "=", 
     RowBox[{"1", "+", 
      RowBox[{"KE0", "*", 
       RowBox[{"eCharge", "/", 
        RowBox[{"(", 
         RowBox[{"mElectron", "*", 
          RowBox[{"cLight", "^", "2"}]}], ")"}]}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta0", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{"1", "/", 
        RowBox[{"gamma0", "^", "2"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"v0", "=", 
     RowBox[{"beta0", "*", "cLight"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"B0", "=", "0.006"}], ";"}], "                  ", 
   RowBox[{"(*", "Tesla", "*)"}], "\n", 
   RowBox[{
    RowBox[{"E0", "=", 
     RowBox[{"v0", "*", "B0"}]}], ";"}], "                 ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"V", "/", "m"}], ",", 
     RowBox[{
     "Wien", " ", "condition", " ", "in", " ", "uniform", " ", "region"}]}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "BuildSymmetricWienFields", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "BuildSymmetricWienFields", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<InterpolationOrder\>\"", "->", "Automatic"}], ",", 
       RowBox[{"\"\<Step\>\"", "->", "0.01"}], ",", 
       RowBox[{"\"\<EDirection\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], ",", 
       RowBox[{"\"\<BDirection\>\"", "->", 
        RowBox[{"{", 
         RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ",", 
       RowBox[{"AccuracyGoal", "->", "10"}], ",", 
       RowBox[{"PrecisionGoal", "->", "10"}], ",", 
       RowBox[{"MaxStepFraction", "->", 
        RowBox[{"1", "/", "500"}]}], ",", 
       RowBox[{"MaxIterations", "->", "50"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"BuildSymmetricWienFields", "[", 
      RowBox[{
      "zMin_", ",", "zMax_", ",", "zInE_", ",", "aE_", ",", "aB_", ",", "E0_",
        ",", "B0_", ",", "v0_", ",", 
       RowBox[{"dz_", ":", "0.002"}], ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "zCen", ",", "zOutE", ",", "nIntervals", ",", "actualDz", ",", 
         "zGrid", ",", "interpOrder", ",", "fringe", ",", "makeETable", ",", 
         "makeBTable", ",", "eFieldTable", ",", "bFieldTableInitial", ",", 
         "bFieldTableClosed", ",", 
         RowBox[{"m", "=", 
          RowBox[{"9.1093837015", "*", 
           RowBox[{"10", "^", 
            RowBox[{"-", "31"}]}]}]}], ",", 
         RowBox[{"c", "=", "299792458."}], ",", "gamma0", ",", "pz0", ",", 
         "refParticle", ",", "trackOnce", ",", "closureX", ",", "closureXP", ",",
          "zInBGuess", ",", "bScaleGuess", ",", "zInBClosed", ",", 
         "bScaleClosed", ",", "zOutBClosed", ",", "sol", ",", "refResult", ",",
          "final"}], "}"}], ",", 
       RowBox[{
        RowBox[{"zCen", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"zMin", "+", "zMax"}], ")"}], "/", "2"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zOutE", "=", 
         RowBox[{
          RowBox[{"2", " ", "zCen"}], "-", "zInE"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"interpOrder", "=", 
         RowBox[{
          RowBox[{"OptionValue", "[", "\"\<InterpolationOrder\>\"", "]"}], "/.",
           " ", 
          RowBox[{"Automatic", "->", 
           RowBox[{"(", 
            RowBox[{"\"\<InterpolationOrder\>\"", "/.", " ", 
             RowBox[{"Options", "[", "WienFilterTrack", "]"}]}], ")"}]}]}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Symmetric", " ", "grid"}], ",", 
          RowBox[{"zCen", " ", "exactly", " ", "on", " ", "grid"}]}], "*)"}], 
        
        RowBox[{"nIntervals", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"2", ",", 
           RowBox[{"2", " ", 
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"zMax", "-", "zMin"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"2", " ", "dz"}], ")"}]}], "]"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"actualDz", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"zMax", "-", "zMin"}], ")"}], "/", "nIntervals"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"zGrid", "=", 
         RowBox[{"N", "@", 
          RowBox[{"Subdivide", "[", 
           RowBox[{"zMin", ",", "zMax", ",", "nIntervals"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"fringe", "[", 
          RowBox[{"z_", ",", "zIn_", ",", "zOut_", ",", "a_"}], "]"}], ":=", 
         RowBox[{
          RowBox[{"1", "/", "2"}], "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Tanh", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"z", "-", "zIn"}], ")"}], "/", "a"}], "]"}], "-", 
            RowBox[{"Tanh", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"z", "-", "zOut"}], ")"}], "/", "a"}], "]"}]}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"makeETable", "[", "]"}], ":=", 
         RowBox[{"N", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"z", ",", 
              RowBox[{"E0", "*", 
               RowBox[{"fringe", "[", 
                RowBox[{"z", ",", "zInE", ",", "zOutE", ",", "aE"}], 
                "]"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "zGrid"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"makeBTable", "[", 
          RowBox[{
           RowBox[{"zInB_", "?", "NumericQ"}], ",", 
           RowBox[{"bScale_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"N", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"z", ",", 
              RowBox[{"bScale", "*", "B0", "*", 
               RowBox[{"fringe", "[", 
                RowBox[{"z", ",", "zInB", ",", 
                 RowBox[{
                  RowBox[{"2", " ", "zCen"}], "-", "zInB"}], ",", "aB"}], 
                "]"}]}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"z", ",", "zGrid"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"eFieldTable", "=", 
         RowBox[{"makeETable", "[", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"zInBGuess", "=", "zInE"}], ";", "\[IndentingNewLine]", 
        RowBox[{"bScaleGuess", "=", "1.0"}], ";", "\[IndentingNewLine]", 
        RowBox[{"bFieldTableInitial", "=", 
         RowBox[{"makeBTable", "[", 
          RowBox[{"zInBGuess", ",", "bScaleGuess"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"MatrixQ", "[", 
            RowBox[{"eFieldTable", ",", "NumericQ"}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<ClosedQ\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<Failed\>\"", "->", "True"}], ",", 
             
             RowBox[{"\"\<Reason\>\"", 
              "->", "\"\<EFieldTable is not numerical.\>\""}], ",", 
             RowBox[{"\"\<EFieldTable\>\"", "->", "eFieldTable"}], ",", 
             RowBox[{"\"\<BFieldTable\>\"", "->", "bFieldTableInitial"}]}], 
            "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"MatrixQ", "[", 
            RowBox[{"bFieldTableInitial", ",", "NumericQ"}], "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<ClosedQ\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<Failed\>\"", "->", "True"}], ",", 
             
             RowBox[{"\"\<Reason\>\"", 
              "->", "\"\<Initial BFieldTable is not numerical.\>\""}], ",", 
             RowBox[{"\"\<EFieldTable\>\"", "->", "eFieldTable"}], ",", 
             RowBox[{"\"\<BFieldTable\>\"", "->", "bFieldTableInitial"}]}], 
            "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Reference", " ", "particle", " ", "from", " ", "v0"}], 
         "*)"}], 
        RowBox[{"gamma0", "=", 
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"v0", "/", "c"}], ")"}], "^", "2"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"pz0", "=", 
         RowBox[{"gamma0", "*", "m", "*", "v0"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"refParticle", "=", 
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
           "0.", ",", "0.", ",", "zMin", ",", "0.", ",", "0.", ",", "pz0"}], 
           "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"trackOnce", "[", 
          RowBox[{
           RowBox[{"zInB_", "?", "NumericQ"}], ",", 
           RowBox[{"bScale_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"btab", ",", "r", ",", "f"}], "}"}], ",", 
           RowBox[{
            RowBox[{"btab", "=", 
             RowBox[{"makeBTable", "[", 
