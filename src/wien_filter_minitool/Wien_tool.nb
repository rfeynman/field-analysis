Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "MakeParticle", ",", "RandomNormalOrFixed", ",", "RandomTwissPair", ",", 
      "GenerateInitialBeam"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"MakeParticle", "[", 
      RowBox[{
      "x_", ",", "y_", ",", "z_", ",", "xp_", ",", "yp_", ",", "KEeV_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "pz", ",", "px", ",", "py"}], "}"}], ",", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"MomentumFromKineticEnergyEV", "[", "KEeV", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"xp", "=", 
           RowBox[{"px", "/", "pz"}]}], ",", 
          RowBox[{"yp", "=", 
           RowBox[{"py", "/", "pz"}]}]}], "*)"}], 
        RowBox[{"pz", "=", 
         RowBox[{"p", "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"1", "+", 
            RowBox[{"xp", "^", "2"}], "+", 
            RowBox[{"yp", "^", "2"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"px", "=", 
         RowBox[{"xp", "*", "pz"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"py", "=", 
         RowBox[{"yp", "*", "pz"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z", ",", "px", ",", "py", ",", "pz"}], 
         "}"}]}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RandomNormalOrFixed", "[", 
      RowBox[{"mean_", ",", "sigma_"}], "]"}], ":=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"sigma", "==", "0"}], ",", "mean", ",", 
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"mean", ",", "sigma"}], "]"}], "]"}]}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"RandomTwissPair", "[", 
      RowBox[{"sigmaX_", ",", "sigmaXp_", ",", "alpha_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eps", ",", "cov", ",", "covMatrix"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sigmaX", "==", "0"}], "&&", 
           RowBox[{"sigmaXp", "==", "0"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", 
            RowBox[{"0.", ",", "0."}], "}"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sigmaX", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", 
            RowBox[{"0.", ",", 
             RowBox[{"RandomNormalOrFixed", "[", 
              RowBox[{"0", ",", "sigmaXp"}], "]"}]}], "}"}], "]"}]}], "]"}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sigmaXp", "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"RandomNormalOrFixed", "[", 
              RowBox[{"0", ",", "sigmaX"}], "]"}], ",", "0."}], "}"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "rms", " ", "emittance", " ", "implied", " ", "by", " ", "sigmaX"}],
           ",", "sigmaXp", ",", "alpha"}], "*)"}], 
        RowBox[{"eps", "=", 
         RowBox[{"sigmaX", "*", 
          RowBox[{"sigmaXp", "/", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"1", "+", 
             RowBox[{"alpha", "^", "2"}]}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{"<", 
           RowBox[{"x", " ", "xp"}], ">"}], " ", "=", 
          RowBox[{
           RowBox[{"-", "alpha"}], " ", "eps"}]}], "*)"}], 
        RowBox[{"cov", "=", 
         RowBox[{
          RowBox[{"-", "alpha"}], "*", "eps"}]}], ";", "\[IndentingNewLine]", 
        
        RowBox[{"covMatrix", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"sigmaX", "^", "2"}], ",", "cov"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"cov", ",", 
             RowBox[{"sigmaXp", "^", "2"}]}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"MultinormalDistribution", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0.", ",", "0."}], "}"}], ",", "covMatrix"}], "]"}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GenerateInitialBeam", "[", 
      RowBox[{
      "nParticles_", ",", "KE0_", ",", "sigmaKE_", ",", "sigmaX_", ",", 
       "sigmaXp_", ",", "alphaX_", ",", "sigmaY_", ",", "sigmaYp_", ",", 
       "alphaY_", ",", 
       RowBox[{"z0_", ":", "0."}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"xPair", ",", "yPair", ",", "KE"}], "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"xPair", "=", 
           RowBox[{"RandomTwissPair", "[", 
            RowBox[{"sigmaX", ",", "sigmaXp", ",", "alphaX"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"yPair", "=", 
           RowBox[{"RandomTwissPair", "[", 
            RowBox[{"sigmaY", ",", "sigmaYp", ",", "alphaY"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"KE", "=", 
           RowBox[{"RandomNormalOrFixed", "[", 
            RowBox[{"KE0", ",", "sigmaKE"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"MakeParticle", "[", 
           RowBox[{
            RowBox[{"xPair", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"yPair", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "z0", ",", 
            RowBox[{"xPair", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"yPair", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "KE"}], "]"}]}], ",", 
         RowBox[{"{", "nParticles", "}"}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nParticles", "=", "100"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"KE0", "=", "320000."}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"320", " ", "keV"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sigmaKE", "=", "3200"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"3.2", " ", "keV", " ", "rms"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sigmaX", "=", "0.001"}], ";"}], "      ", 
   RowBox[{"(*", 
    RowBox[{"1", " ", "mm"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sigmaXp", "=", "0.0001"}], ";"}], "    ", 
   RowBox[{"(*", 
    RowBox[{"0.1", " ", "mrad"}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"sigmaY", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigmaYp", "=", "0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"alphaX", "=", 
     RowBox[{"-", "2.0"}]}], ";"}], "        ", 
   RowBox[{"(*", 
    RowBox[{"converging", " ", "beam"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"alphaY", "=", "0.0"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"particles", "=", 
     RowBox[{"GenerateInitialBeam", "[", 
      RowBox[{
      "nParticles", ",", "KE0", ",", "sigmaKE", ",", "sigmaX", ",", "sigmaXp",
        ",", "alphaX", ",", "sigmaY", ",", "sigmaYp", ",", "alphaY", ",", 
       "0."}], "]"}]}], ";"}], "\n"}]}]], "Input",
 CellChangeTimes->{{3.9897574617713633`*^9, 3.989757461772213*^9}, {
   3.98975754617715*^9, 3.989757546504808*^9}, {3.989838052324636*^9, 
   3.9898380528802433`*^9}, {3.990097619614287*^9, 3.990097636350878*^9}, {
   3.99009779825576*^9, 3.990097805471979*^9}, {3.990099831006517*^9, 
   3.9900998311974382`*^9}, {3.990100459179263*^9, 3.990100462610983*^9}, {
   3.990100530391522*^9, 3.990100533726804*^9}, {3.9901007486304073`*^9, 
   3.990100752463149*^9}, 3.990100803350396*^9, {3.990101061987815*^9, 
   3.990101065961492*^9}, {3.990101103311232*^9, 3.990101104011855*^9}, {
