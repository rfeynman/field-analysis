                 RowBox[{"[", "6", "]"}], "]"}]}], "]"}]}], "    ", 
             RowBox[{"(*", 
              RowBox[{"xpFinal", "=", 
               RowBox[{"px", "/", "pz"}]}], "*)"}], "}"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"closureXP", "[", 
          RowBox[{
           RowBox[{"zInB_", "?", "NumericQ"}], ",", 
           RowBox[{"bScale_", "?", "NumericQ"}]}], "]"}], ":=", 
         RowBox[{
