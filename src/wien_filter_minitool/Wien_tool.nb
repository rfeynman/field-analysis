 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"PlotParticlePhaseSpaces", ",", "PlotZbeam"}], "]"}], ";"}], 
   "\n", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"PlotZbeam", "[", 
      RowBox[{"result_", ",", 
       RowBox[{"eRange_", ":", "Automatic"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dist", ",", "nSteps", ",", "nParticles", ",", 
         RowBox[{"m", "=", 
          RowBox[{"9.1093837015", "*", 
           RowBox[{"10", "^", 
            RowBox[{"-", "31"}]}]}]}], ",", 
         RowBox[{"c", "=", "299792458."}], ",", 
         RowBox[{"e", "=", 
          RowBox[{"1.602176634", "*", 
           RowBox[{"10", "^", 
            RowBox[{"-", "19"}]}]}]}], ",", "keV", ",", "data", ",", "allKE", 
         ",", "range", ",", "cf", ",", "scaleKE", ",", "keColor", ",", 
         "curvesZX", ",", "curvesZXP", ",", "p1", ",", "p2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"dist", "=", 
         RowBox[{"result", "[", "\"\<Distributions\>\"", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"nSteps", "=", 
         RowBox[{"Length", "[", "dist", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"nParticles", "=", 
         RowBox[{"Min", "[", 
          RowBox[{"Length", "/@", "dist"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"keV", "[", "p_", "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", "g", "}"}], ",", 
           RowBox[{
            RowBox[{"g", "=", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"1", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"p", ".", "p"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"m", "^", "2"}], "*", 
                  RowBox[{"c", "^", "2"}]}], ")"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"g", "-", "1"}], ")"}], "*", "m", "*", 
             RowBox[{
              RowBox[{
               RowBox[{"c", "^", "2"}], "/", "e"}], "/", "1000"}]}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"data", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"dist", "[", 
