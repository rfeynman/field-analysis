           RowBox[{"{", 
            RowBox[{"i", ",", "nParticles"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "nSteps"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"allKE", "=", 
         RowBox[{"Flatten", "[", 
