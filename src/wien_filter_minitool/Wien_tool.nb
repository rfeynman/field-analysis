                RowBox[{
                 RowBox[{"n", ">", "1"}], ",", 
                 RowBox[{"StandardDeviation", "[", "yp", "]"}], ",", "0."}], 
                "]"}]}], ",", 
              RowBox[{"\"\<MeanKineticEnergy_eV\>\"", "->", 
               RowBox[{"Mean", "[", "ke", "]"}]}], ",", 
              RowBox[{"\"\<SigmaKineticEnergy_eV\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"n", ">", "1"}], ",", 
                 RowBox[{"StandardDeviation", "[", "ke", "]"}], ",", "0."}], 
                "]"}]}], ",", 
              RowBox[{"\"\<RelativeEnergySpread\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mean", "[", "ke", "]"}], "==", "0"}], ",", 
                 "Indeterminate", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"n", ">", "1"}], ",", 
                   RowBox[{
                    RowBox[{"StandardDeviation", "[", "ke", "]"}], "/", 
                    RowBox[{"Mean", "[", "ke", "]"}]}], ",", "0."}], "]"}]}], 
                "]"}]}], ",", 
              RowBox[{"\"\<EmitXGeom_mrad\>\"", "->", "epsX"}], ",", 
              RowBox[{"\"\<EmitYGeom_mrad\>\"", "->", "epsY"}], ",", 
              RowBox[{"\"\<EmitXNorm_mrad\>\"", "->", "epsNX"}], ",", 
              RowBox[{"\"\<EmitYNorm_mrad\>\"", "->", "epsNY"}]}], "|>"}]}]}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"beamParameters", "=", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"<|", 
               RowBox[{"\"\<z\>\"", "->", "#1"}], "|>"}], ",", 
              RowBox[{"statsAtPlane", "[", "#2", "]"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"zPlanes", ",", "distributions"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<ZPlanes\>\"", "->", "zPlanes"}], ",", 
          RowBox[{"\"\<Distributions\>\"", "->", "distributions"}], ",", 
          RowBox[{"\"\<TimeOfFlight\>\"", "->", "timeOfFlight"}], ",", 
          RowBox[{"\"\<BeamParameters\>\"", "->", "beamParameters"}], ",", 
          RowBox[{"\"\<Solutions\>\"", "->", "sols"}]}], "|>"}]}]}], "]"}]}], 
    ";"}]}]}]], "Input",
