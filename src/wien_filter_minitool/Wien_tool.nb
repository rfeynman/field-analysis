          RowBox[{
           RowBox[{"!", 
            RowBox[{"MatrixQ", "[", 
             RowBox[{"particles", ",", "NumericQ"}], "]"}]}], "||", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "particles", "]"}], "[", 
