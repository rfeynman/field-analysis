               RowBox[{"OptionValue", "[", "PrecisionGoal", "]"}]}], ",", 
              RowBox[{"MaxStepFraction", "->", 
               RowBox[{"OptionValue", "[", "MaxStepFraction", "]"}]}]}], 
             "]"}], ",", "$Failed"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"refResult", "===", "$Failed"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<ClosedQ\>\"", "->", "False"}], ",", 
             RowBox[{"\"\<Failed\>\"", "->", "True"}], ",", 
             
             RowBox[{"\"\<Reason\>\"", 
              "->", "\"\<Final reference tracking failed. Returning closed B \
table but no final check.\>\""}], ",", 
