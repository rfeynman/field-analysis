                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"m", "^", "2"}], "*", 
                  RowBox[{"c", "^", "2"}]}], ")"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"gamma", "-", "1."}], ")"}], "*", "m", "*", 
             RowBox[{
              RowBox[{
               RowBox[{"c", "^", "2"}], "/", "e"}], "/", "1000."}]}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
